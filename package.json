{
  "name": "motionbench",
  "version": "2.19.0-desktop.1",
  "private": true,
  "description": "Offline sport performance assessment and contextual coaching reports",
  "scripts": {
    "test:v219-management": "node tests/management-v219-browser-tests.cjs && node tests/management-v219-browser-tests.cjs --edge",
    "test:v219-storage": "node tests/storage-v219-browser-tests.cjs && node tests/storage-v219-browser-tests.cjs --edge",
    "test:v219-acquisition": "node tests/acquisition-v219-browser-tests.cjs && node tests/acquisition-v219-browser-tests.cjs --edge",
    "test:v219-report": "node tests/report-v219-browser-tests.cjs --pdf && node tests/report-v219-browser-tests.cjs --edge --pdf",
    "build": "python scripts/build.py",
    "test": "node tests/run-unit-tests.cjs",
    "test:browser": "node tests/redesign-browser-tests.cjs",
    "test:workflow": "node tests/workflow-browser-tests.cjs",
    "test:pdf": "node tests/pdf-module-tests.cjs --artifact-dir output/pdf/v2.17.3-work/module",
    "test:pdf-download": "node tests/pdf-download-tests.cjs --artifact-dir output/pdf/v2.17.3-work/download",
    "test:pdf-failure": "node tests/pdf-failure-ui-tests.cjs --artifact-dir output/pdf/v2.17.3-work/failure",
    "test:visual": "node tests/visual-review.cjs",
    "test:core": "node tests/core-browser-tests.cjs",
    "test:radar": "node tests/radar-browser-tests.cjs",
    "test:display": "node tests/display-browser-tests.cjs",
    "test:speed": "node tests/speed-reference-browser-tests.cjs",
    "test:ai-live": "node tests/live-ai-tests.cjs",
    "verify:delivery": "python scripts/verify_delivery.py",
    "test:design": "node tests/design-review.cjs",
    "test:chart-ai": "node tests/chart-ai-browser-tests.cjs",
    "test:ai-flow": "node tests/ai-narrative-browser-tests.cjs",
    "test:repeats": "node tests/repeat-browser-tests.cjs --artifact-dir output/pdf/v2.17.3-work/repeats",
    "test:repeat-pdf": "node tests/repeat-pdf-tests.cjs --artifact-dir output/pdf/v2.17.3-work/repeat-pdf",
    "test:iso-layout": "node tests/iso-layout-browser-tests.cjs",
    "start": "python scripts/serve.py",
    "test:ai-service": "node tests/ai-service-browser-tests.cjs",
    "test:management": "node tests/management-browser-tests.cjs && node tests/management-browser-tests.cjs --edge && node tests/management-admin-tests.cjs && node tests/management-resilience-tests.cjs && node tests/management-visual-tests.cjs",
    "test:capacity": "node tests/management-capacity-tests.cjs && node tests/management-capacity-tests.cjs --edge && python tests/management-backup-integrity.py && node tests/management-restart-tests.cjs",
    "test:management-pdf": "node tests/management-delivery-tests.cjs",
    "test:catalog": "node tests/unified-catalog-browser-tests.cjs && node tests/unified-catalog-browser-tests.cjs --edge",
    "test:report-v210": "node tests/report-v210-browser-tests.cjs && node tests/report-v210-browser-tests.cjs --edge --ui-only",
    "test:imtp-layout-v210": "node tests/imtp-layout-v210-browser-tests.cjs && node tests/imtp-layout-v210-browser-tests.cjs --edge --ui-only",
    "test:refinement": "node tests/refinement-workflow-browser-tests.cjs && node tests/refinement-workflow-browser-tests.cjs --edge && node tests/refinement-race-browser-tests.cjs && node tests/refinement-race-browser-tests.cjs --edge && node tests/management-refinement-browser-tests.cjs && node tests/management-refinement-browser-tests.cjs --edge && node tests/refinement-report-browser-tests.cjs",
    "test:excel": "node tests/excel-model-tests.cjs && node tests/excel-workflow-browser-tests.cjs && node tests/excel-workflow-browser-tests.cjs --edge",
    "test:iso-selection": "node tests/isometric-selection-model-tests.cjs && node tests/isometric-selection-browser-tests.cjs && node tests/isometric-selection-browser-tests.cjs --edge",
    "test:entry": "node tests/unified-entry-browser-tests.cjs && node tests/unified-entry-browser-tests.cjs --edge",
    "test:toolbar": "node tests/report-toolbar-browser-tests.cjs && node tests/report-toolbar-browser-tests.cjs --edge",
    "test:athlete-context": "node tests/athlete-context-browser-tests.cjs && node tests/athlete-context-browser-tests.cjs --edge",
    "test:athlete-context-live": "node tests/athlete-context-live-ai-tests.cjs",
    "test:v216-migration": "node tests/v216-migration-browser-tests.cjs && node tests/v216-migration-browser-tests.cjs --edge",
    "test:v216-report": "node tests/report-v216-browser-tests.cjs && node tests/report-v216-browser-tests.cjs --edge",
    "test:fvp-regions": "node tests/fvp-three-region-browser-tests.cjs --artifact-dir output/playwright/fvp-three-regions/fixed && node tests/fvp-three-region-browser-tests.cjs --edge --artifact-dir output/playwright/fvp-three-regions/fixed",
    "test:sprint": "node tests/sprint-fvp-browser-tests.cjs --artifact-dir output/playwright/sprint-fvp-2.17.5-local && node tests/sprint-fvp-browser-tests.cjs --edge --artifact-dir output/playwright/sprint-fvp-2.17.5-local",
    "test:sprint-pdf": "node tests/sprint-fvp-browser-tests.cjs --pdf --artifact-dir output/playwright/sprint-fvp-2.17.5-local",
    "test:entry-concurrency": "node tests/entry-concurrency-browser-tests.cjs --artifact-dir output/playwright/entry-concurrency-2.17.3/final && node tests/entry-concurrency-browser-tests.cjs --edge --artifact-dir output/playwright/entry-concurrency-2.17.3/final",
    "test:storage-repros": "node tests/storage-concurrency-repros.cjs --artifact-dir output/playwright/storage-repros-v2.17.3/final && node tests/storage-concurrency-repros.cjs --edge --artifact-dir output/playwright/storage-repros-v2.17.3/final",
    "test:split-id-import": "node tests/sprint-split-id-import-tests.cjs --artifact-dir output/playwright/split-id-import-2.17.3/final && node tests/sprint-split-id-import-tests.cjs --edge --artifact-dir output/playwright/split-id-import-2.17.3/final",
    "start:desktop": "npm run build && electron .",
    "pack:desktop": "npm run build && electron-builder --config electron-builder.yml --dir --publish never",
    "dist:windows": "npm run build && electron-builder --config electron-builder.yml --win --x64 --publish never",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "test:desktop-unit": "node tests/desktop-security-tests.cjs && node tests/desktop-ai-tests.cjs",
    "verify:desktop-package": "node scripts/check-desktop-package.cjs"
  },
  "devDependencies": {
    "playwright": "1.57.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "author": "Zeke Niu",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  }
}
